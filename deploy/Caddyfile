# DOMINIO viene de .env. Caddy pide y renueva solo el certificado de Let's Encrypt
# (el dominio tiene que apuntar ya al servidor y los puertos 80 y 443 estar abiertos).
{$DOMINIO} {
	encode zstd gzip

	# La API, al backend. Caddy añade X-Forwarded-For con la IP del cliente, que el backend usa para el límite por IP
	handle /api/* {
		reverse_proxy app:8080
	}

	# El resto es el frontend: las rutas de React (/reservar/..., /agenda) devuelven index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

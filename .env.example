# Copiar a .env en el servidor y rellenar. .env no se sube al repositorio.
# Ojo con los valores que llevan $ (el hash de la clave): entre comillas simples, o Docker Compose los interpreta.

# Dominio de la web, ya apuntando al servidor. Caddy pide el certificado HTTPS para él
DOMINIO=citas.ejemplo.es

# Contraseña de la base de datos (la usan Postgres, el backend y las copias). Larga y aleatoria:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Clave de la agenda del comercio, como hash bcrypt (ver docs/configuracion.md#clave-de-la-agenda)
HUECO_AGENDA_CLAVE_HASH='$2a$10$...'
# HUECO_AGENDA_USUARIO=comercio

# Emails de las reservas (opcional: sin SPRING_MAIL_HOST no se manda nada y la reserva funciona igual)
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# HUECO_EMAIL_REMITENTE='Peluquería Ejemplo <citas@peluqueria.es>'
# HUECO_EMAIL_NOMBRECOMERCIO='Peluquería Ejemplo'
# Quién recibe el aviso de cada cita; vacío: el email del negocio
# HUECO_EMAIL_AVISOCOMERCIO=

# Copias de la base de datos: hora (0-23) y zona horaria
# HORA_BACKUP=3
# TZ=Europe/Madrid
